{
    "name": "foodics/db-hound",
    "description": "A Laravel package that watches your query log, analyze it and automatically suggests missing indices.",
    "keywords": [
        "Foodics",
        "laravel",
        "db-hound"
    ],
    "homepage": "https://github.com/foodics/db-hound",
    "license": "MIT",
    "authors": [
        {
            "name": "Yazan Stash (Foodics)",
            "email": "y.bastas@foodics.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "phpmyadmin/sql-parser": "^6.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Foodics\\DbHound\\": "src/",
            "Foodics\\DbHound\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Foodics\\DbHound\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test:unit": "vendor/bin/pest --testsuite=Unit",
        "test:integration": "DB_HOUND_MYSQL=8.0 vendor/bin/pest --testsuite=Integration",
        "test:integration:84": "DB_HOUND_MYSQL=8.4 vendor/bin/pest --testsuite=Integration",
        "services:up": "docker compose up -d --wait",
        "services:down": "docker compose down",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Foodics\\DbHound\\DbHoundServiceProvider"
            ],
            "aliases": {
                "DbHound": "Foodics\\DbHound\\Facades\\DbHound"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
